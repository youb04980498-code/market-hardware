# Copy to .env, then run scripts/prepare-cold-start.ps1 ONLY on a new installation.
# Never replace credentials belonging to existing volumes. Never commit .env.
POSTGRES_USER=market_admin
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
POSTGRES_DB=market_db
MONGO_ROOT_USER=market_admin
MONGO_ROOT_PASSWORD=REPLACE_MONGO_ROOT_PASSWORD
MINIO_ROOT_USER=marketadmin
MINIO_ROOT_PASSWORD=REPLACE_MINIO_ROOT_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_GRAFANA_ADMIN_PASSWORD
NEO4J_PASSWORD=REPLACE_NEO4J_PASSWORD
# Phase 2 generates these local service credentials; never use admin credentials in APIs.
PG_AUTH_PASSWORD=REPLACE_PG_AUTH_PASSWORD
PG_ORDERS_PASSWORD=REPLACE_PG_ORDERS_PASSWORD
PG_INVENTORY_PASSWORD=REPLACE_PG_INVENTORY_PASSWORD
PG_PAYMENTS_PASSWORD=REPLACE_PG_PAYMENTS_PASSWORD

# Populated by configure-catalog.py after UnoPim first-boot migrations/seeding.
MONGO_CATALOG_READ_USER=
MONGO_CATALOG_READ_PASSWORD=
MONGO_CATALOG_SYNC_USER=
MONGO_CATALOG_SYNC_PASSWORD=
UNOPIM_CLIENT_ID=
UNOPIM_CLIENT_SECRET=
UNOPIM_USERNAME=
UNOPIM_PASSWORD=

# Populated by configure-commerce.py (via start-commerce.ps1).
JWT_SECRET=
INTERNAL_JWT_SECRET=
PG_OUTBOX_PASSWORD=
DEV_ADMIN_EMAIL=phase4.admin@example.test
DEV_ADMIN_PASSWORD=
DEV_CUSTOMER_EMAIL=phase4.customer@example.test
DEV_CUSTOMER_PASSWORD=
DEV_OTHER_EMAIL=phase4.other@example.test
DEV_OTHER_PASSWORD=
COMMERCE_TESTING=0
AUTH_COOKIE_SECURE=0
# start-commerce.ps1 -WithKafka writes 1; the full platform requires publication.
KAFKA_ENABLED=0

# Populated by configure-analytics.py and configure-operations.py.
PG_ANALYTICS_READER_PASSWORD=
PG_ANALYTICS_WRITER_PASSWORD=
PG_ANALYTICS_API_PASSWORD=
ANALYTICS_PSEUDONYM_KEY=
ANALYTICS_TESTING=0
PG_MONITOR_PASSWORD=
PG_LOG_RETENTION_PASSWORD=
MONGO_MONITOR_PASSWORD=
MONGODB_MONITOR_URI=
# Optional thresholds/timers use the defaults in docker-compose.yml.
