  "components": {
    "schemas": {
      "Checkout": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          },
          "warehouse_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Warehouse Id",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "Checkout"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "product_id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "unit_price_cents": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price Cents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "Item"
      },
      "Plan": {
        "properties": {
          "user_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "User Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "simulation": {
            "type": "string",
            "enum": [
              "success",
              "decline",
              "timeout_once",
              "timeout_succeeded",
              "refund_fail_once"
            ],
            "title": "Simulation",
            "default": "success"
          },
          "fault": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pause_after_reserve",
                  "crash_after_reserve",
                  "crash_after_payment",
                  "crash_after_finalize",
                  "finalize_fail_once",
                  "finalize_permanent",
                  "compensation_fail_once"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault"
          },
          "reservation_ttl": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 1.0,
            "title": "Reservation Ttl",
            "default": 900
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "idempotency_key"
        ],
        "title": "Plan"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
