  "components": {
    "schemas": {
      "Adjustment": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "warehouse_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Warehouse Id"
          },
          "delta": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": -100000.0,
            "title": "Delta"
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "warehouse_id",
          "delta",
          "reason"
        ],
        "title": "Adjustment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Line": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "warehouse_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Warehouse Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "warehouse_id",
          "quantity"
        ],
        "title": "Line"
      },
      "Reserve": {
        "properties": {
          "order_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Order Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          },
          "ttl_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Ttl Seconds",
            "default": 900
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_id",
          "items"
        ],
        "title": "Reserve"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Warehouse": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "capacity_units": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Capacity Units"
          },
          "classification": {
            "type": "string",
            "pattern": "^(OPERATIONAL|TEST|ARCHIVED)$",
            "title": "Classification",
            "default": "OPERATIONAL"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "city",
          "capacity_units"
        ],
        "title": "Warehouse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
